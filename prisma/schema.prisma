generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model SettingSekolah {
  id                String   @id @default(cuid()) @db.VarChar(191)
  namaSekolah       String   @default("MIS AL ASY'ARIYAH") @db.Text
  logo              String   @default("") @db.Text
  alamat            String   @default("") @db.Text
  npsn              String   @default("") @db.VarChar(191)
  email             String   @default("") @db.VarChar(191)
  website           String   @default("") @db.VarChar(191)
  telepon           String   @default("") @db.VarChar(191)
  kepalaSekolah     String   @default("") @db.VarChar(191)
  nipKepalaSekolah  String   @default("") @db.VarChar(191)
  motto             String   @default("") @db.Text
  visi              String   @default("") @db.Text
  misi              String   @default("") @db.Text
  semesterAktif     String   @default("Genap") @db.VarChar(191)
  tahunAjaranAktif  String   @default("2024/2025") @db.VarChar(191)
  tema              String   @default("light") @db.VarChar(191)
  darkMode          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Role {
  id        String          @id @default(cuid()) @db.VarChar(191)
  slug      String          @unique @db.VarChar(191)
  nama      String          @db.VarChar(191)
  deskripsi String          @default("") @db.Text
  status    String          @default("aktif") @db.VarChar(191)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  permissions RolePermission[]
  users      UserRole[]
}

model Permission {
  id       String          @id @default(cuid()) @db.VarChar(191)
  slug     String          @unique @db.VarChar(191)
  nama     String          @db.VarChar(191)
  kategori String          @default("umum") @db.VarChar(191)
  status   String          @default("aktif") @db.VarChar(191)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  roles    RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid()) @db.VarChar(191)
  roleId       String     @db.VarChar(191)
  permissionId String     @db.VarChar(191)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid()) @db.VarChar(191)
  userId String @db.VarChar(191)
  roleId String @db.VarChar(191)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, roleId])
}

model User {
  id           String     @id @default(cuid()) @db.VarChar(191)
  nama         String     @db.VarChar(191)
  username     String     @unique @db.VarChar(191)
  password     String     @db.VarChar(191)
  passwordText String     @default("") @db.VarChar(191)
  role         String     @default("guru") @db.VarChar(191)
  status       String     @default("aktif") @db.VarChar(191)
  foto         String   @default("") @db.Text
  email        String     @default("") @db.VarChar(191)
  noHP         String   @default("") @db.VarChar(191)
  nip          String   @default("") @db.VarChar(191)
  jabatan      String   @default("") @db.VarChar(191)
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  userRoles    UserRole[]
}

model Guru {
  id           String   @id @default(cuid()) @db.VarChar(191)
  nip          String   @unique @db.VarChar(191)
  nama         String   @db.VarChar(191)
  gelar        String   @default("") @db.VarChar(191)
  jenisKelamin String   @default("Laki-laki") @db.VarChar(191)
  tempatLahir  String   @default("") @db.VarChar(191)
  tanggalLahir String   @default("") @db.VarChar(191)
  alamat       String   @default("") @db.Text
  email        String   @default("") @db.VarChar(191)
  noHP         String   @default("") @db.VarChar(191)
  mapel        String   @default("") @db.VarChar(191)
  status       String   @default("aktif") @db.VarChar(191)
  foto         String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Siswa {
  id           String   @id @default(cuid()) @db.VarChar(191)
  nis          String   @unique @db.VarChar(191)
  nisn         String   @default("") @db.VarChar(191)
  nama         String   @db.VarChar(191)
  jenisKelamin String   @default("Laki-laki") @db.VarChar(191)
  tempatLahir  String   @default("") @db.VarChar(191)
  tanggalLahir String   @default("") @db.VarChar(191)
  agama        String   @default("Islam") @db.VarChar(191)
  alamat       String   @default("") @db.Text
  namaAyah     String   @default("") @db.VarChar(191)
  namaIbu      String   @default("") @db.VarChar(191)
  noHP         String   @default("") @db.VarChar(191)
  kelas        String   @default("") @db.VarChar(191)
  status       String   @default("aktif") @db.VarChar(191)
  foto         String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Kelas {
  id        String @id @default(cuid()) @db.VarChar(191)
  kodeKelas String @unique @db.VarChar(191)
  namaKelas String @db.VarChar(191)
  waliKelas String @default("") @db.VarChar(191)
  status    String @default("aktif") @db.VarChar(191)
}

model MataPelajaran {
  id        String @id @default(cuid()) @db.VarChar(191)
  kodeMapel String @unique @db.VarChar(191)
  namaMapel String @db.VarChar(191)
  kkm       Int    @default(75)
  guru      String   @default("") @db.VarChar(191)
  status    String   @default("aktif") @db.VarChar(191)
}

model TahunAjaran {
  id     String @id @default(cuid()) @db.VarChar(191)
  nama   String @unique @db.VarChar(191)
  status String @default("aktif") @db.VarChar(191)
}

model Semester {
  id       String @id @default(cuid()) @db.VarChar(191)
  semester String @unique @db.VarChar(191)
  status   String   @default("aktif") @db.VarChar(191)
}

model Nilai {
  id          String   @id @default(cuid()) @db.VarChar(191)
  tahunAjaran String   @default("2024/2025") @db.VarChar(191)
  semester    String   @default("Genap") @db.VarChar(191)
  kelas       String   @default("") @db.VarChar(191)
  mapel       String   @default("") @db.VarChar(191)
  guru        String   @default("") @db.VarChar(191)
  nis         String   @default("") @db.VarChar(191)
  nama        String   @default("") @db.VarChar(191)
  ph1         Float    @default(0)
  ph2         Float    @default(0)
  ph3         Float    @default(0)
  ph4         Float    @default(0)
  pts         Float    @default(0)
  pas         Float    @default(0)
  rataRata    Float    @default(0)
  nilaiAkhir  Float    @default(0)
  predikat    String   @default("") @db.VarChar(191)
  deskripsi   String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AbsensiGuru {
  id         String   @id @default(cuid()) @db.VarChar(191)
  tanggal    String   @default("") @db.VarChar(191)
  namaGuru   String   @default("") @db.VarChar(191)
  nip        String   @default("") @db.VarChar(191)
  jamMasuk   String   @default("") @db.VarChar(191)
  jamPulang  String   @default("") @db.VarChar(191)
  durasi     String   @default("") @db.VarChar(191)
  status     String   @default("") @db.VarChar(191)
  latitude   String   @default("") @db.VarChar(191)
  longitude  String   @default("") @db.VarChar(191)
  alamat     String   @default("") @db.Text
  browser    String   @default("") @db.VarChar(191)
  device     String   @default("") @db.VarChar(191)
  ip         String   @default("") @db.VarChar(191)
  keterangan String   @default("") @db.Text
  createdAt  DateTime @default(now())
}

model AbsensiSiswa {
  id         String  @id @default(cuid()) @db.VarChar(191)
  tanggal    String  @default("") @db.VarChar(191)
  kelas      String  @default("") @db.VarChar(191)
  nis        String  @default("") @db.VarChar(191)
  nama       String  @default("") @db.VarChar(191)
  status     String  @default("Hadir") @db.VarChar(191)
  keterangan String  @default("") @db.Text
  guru       String  @default("") @db.VarChar(191)
  createdAt  DateTime @default(now())
}

model Pengumuman {
  id        String   @id @default(cuid()) @db.VarChar(191)
  judul     String   @db.VarChar(191)
  isi       String   @default("") @db.Text
  lampiran  String   @default("") @db.Text
  tanggal   String   @default("") @db.VarChar(191)
  status    String   @default("aktif") @db.VarChar(191)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(191)
  tanggal    String   @default("") @db.VarChar(191)
  user       String   @default("") @db.VarChar(191)
  role       String   @default("") @db.VarChar(191)
  aktivitas  String   @default("") @db.Text
  ip         String   @default("") @db.VarChar(191)
  detail     String   @default("") @db.Text
  createdAt  DateTime @default(now())
}

model Backup {
  id            String   @id @default(cuid()) @db.VarChar(191)
  namaFile      String   @default("") @db.VarChar(191)
  ukuran        String   @default("") @db.VarChar(191)
  tanggalBackup String   @default("") @db.VarChar(191)
  status        String   @default("aktif") @db.VarChar(191)
  createdAt     DateTime @default(now())
}

model Alumni {
  id         String @id @default(cuid()) @db.VarChar(191)
  nis        String @default("") @db.VarChar(191)
  nama       String @default("") @db.VarChar(191)
  tahunLulus String @default("") @db.VarChar(191)
  keterangan String   @default("") @db.Text
}

model JurnalMengajar {
  id         String  @id @default(cuid()) @db.VarChar(191)
  tanggal    String  @default("") @db.VarChar(191)
  guru       String  @default("") @db.VarChar(191)
  kelas      String  @default("") @db.VarChar(191)
  mapel      String  @default("") @db.VarChar(191)
  materi     String  @default("") @db.Text
  keterangan String  @default("") @db.Text
  createdAt  DateTime @default(now())
}

model RiwayatLogin {
  id         String   @id @default(cuid()) @db.VarChar(191)
  user       String   @default("") @db.VarChar(191)
  role       String   @default("") @db.VarChar(191)
  waktuLogin String   @default("") @db.VarChar(191)
  ipAddress  String   @default("") @db.VarChar(191)
  userAgent  String   @default("") @db.Text
  createdAt  DateTime @default(now())
}
