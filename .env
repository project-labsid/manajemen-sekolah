# ============================================
# Database MySQL - siakad_sdmi
# ============================================
# Sesuaikan dengan konfigurasi MySQL lokal Anda
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Contoh XAMPP (default):
#   mysql://root:@localhost:3306/siakad_sdmi
#
# Setelah import SQL ke phpMyAdmin,
# jalankan: npx prisma generate
# ============================================

DATABASE_URL="mysql://root:@localhost:3306/siakad_sdmi"

# Secret key untuk JWT (ganti di production)
JWT_SECRET=siakad-secret-key-2024
