# ============================================
# Database Configuration
# ============================================
# Mode saat ini: SQLite (default, langsung jalan)
#
# Untuk switch ke MySQL (phpMyAdmin):
#   1. Ganti provider di prisma/schema.prisma: mysql
#   2. Ganti URL di bawah ini ke:
#      DATABASE_URL="mysql://root:@localhost:3306/siakad_sdmi"
#   3. Import database_siakad.sql ke phpMyAdmin
#   4. Jalankan: npx prisma generate
#
# ============================================

DATABASE_URL="file:./dev.db"

# Secret key untuk JWT (ganti di production)
JWT_SECRET=siakad-secret-key-2024
