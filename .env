# ============================================
# Supabase Database Configuration
# ============================================
# Ganti URL dibawah ini dengan URL Supabase Anda
#
# Cara mendapatkan URL:
# 1. Buka https://supabase.com/dashboard
# 2. Pilih project Anda
# 3. Klik Settings > Database
# 4. Copy "Connection string" > "URI" format
#
# Gunakan format:
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# ============================================

# Connection pooler URL (untuk aplikasi runtime - port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"

# Direct connection URL (untuk migration/schema management - port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres"
