# 1. Database MySQL (WAJIB)
#    - Lokal Laragon: mysql://root:@localhost:3306/siakad_sdmi
#    - Aiven Cloud:   mysql://user:password@host:port/dbname?sslmode=require
DATABASE_URL="mysql://root:@localhost:3306/siakad_sdmi"

# 2. JWT Secret (WAJIB - ganti di production!)
#    Gunakan string acak yang panjang, misalnya:
#    bisa generate di https://generate-secret.vercel.app/32
JWT_SECRET="siakad-secret-key-2024"
